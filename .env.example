# SAMA Dashboard environment variables
# Copy to .env.local and fill in for development.

# ── Supabase (auth + data) ──────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── SAMA Agent backend ──────────────────────────────────────────────────────
# Server-side only. The Next.js /api/sama proxy forwards browser calls to
# this URL after attaching the validated Supabase tenant headers. The
# browser never hits the backend directly — the backend's tenant
# middleware rejects unauthenticated calls with 401.
SAMA_API_URL=https://web-production-5324a.up.railway.app
# Set to 0 to allow unauthenticated callers through the proxy (dev only).
SAMA_PROXY_REQUIRE_AUTH=1
# Kill switch — set to 1 to make the proxy 503 every request.
BACKEND_PAUSED=0
# Allow auto-fired calls to expensive (LLM/SerpAPI) endpoints. Default off.
SAMA_ALLOW_EXPENSIVE_PATHS=0

# ── Public AI-readiness audit ───────────────────────────────────────────────
PUBLIC_AUDIT_TENANT_ID=public
PUBLIC_AUDIT_MAX_PAGES=5
# Per-IP rate limit. 3 audits/hour by default.
PUBLIC_AUDIT_RATE_LIMIT=3
PUBLIC_AUDIT_RATE_WINDOW_MS=3600000
# Captcha enforcement. Flip to 1 once Turnstile is wired into the form.
PUBLIC_AUDIT_REQUIRE_CAPTCHA=0
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# ── Rate limiter ────────────────────────────────────────────────────────────
# memory | upstash. Memory is per-lambda; upstash is replica-safe.
RATE_LIMIT_BACKEND=memory
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── Security headers ────────────────────────────────────────────────────────
# Set to 1 once CSP report-only shows no violations to flip to enforcement.
CSP_ENFORCE=0

# ── Agent run streaming ────────────────────────────────────────────────────
# Set NEXT_PUBLIC_AGENT_RUN_STREAM=0 to force-disable the SSE path and use polling.
NEXT_PUBLIC_AGENT_RUN_STREAM=1

# ── Apollo telemarketing campaigns ─────────────────────────────────────────
# HMAC secret used to sign the per-lead PDF render URL. The Playwright
# service in sama-agent fetches the report page using a token signed with
# this secret — anyone with the secret can read any lead's report, so treat
# it like the service-role key. Generate with `openssl rand -hex 32`.
PDF_SIGNING_SECRET=
# Used to construct the absolute URL of the report page that Playwright
# opens. Defaults to the request origin if unset, but in production this
# should be your canonical dashboard URL (e.g. https://app.successifier.com).
PUBLIC_DASHBOARD_URL=
# Optional shared secret between dashboard and sama-agent. When set, the
# /api/admin/.../pdf route forwards it as X-Sama-Internal-Token, and the
# agent's PDF render endpoint requires the matching value.
SAMA_INTERNAL_TOKEN=
# How many leads each /run invocation will audit. Tune up if your Vercel
# plan allows longer maxDuration (Pro = 300s ~ 8 leads at default size).
APOLLO_BATCH_SIZE=8

# ── Stripe (subscriptions + 3-day trial) ───────────────────────────────────
# The dashboard uses Stripe Checkout / Billing Portal only — all keys live on
# the backend (sama-agent). The checkout/portal URLs come back via the
# /api/sama proxy. Set NEXT_PUBLIC_APP_URL to the canonical dashboard URL
# so the backend's success/cancel redirects land on the right host.
NEXT_PUBLIC_APP_URL=https://app.successifier.com

# ── Observability ──────────────────────────────────────────────────────────
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.05
