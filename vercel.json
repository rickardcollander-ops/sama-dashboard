{
  "buildCommand": "npm run build",
  "devCommand": "npm run dev",
  "installCommand": "npm install",
  "framework": "nextjs",
  "outputDirectory": ".next",
  "crons": [
    {
      "path": "/api/integrations/cron",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/integrations/cron/weekly-agents",
      "schedule": "30 5 * * 1"
    },
    {
      "path": "/api/integrations/cron/weekly-agents",
      "schedule": "30 6 * * 1"
    },
    {
      "path": "/api/integrations/cron/daily-content",
      "schedule": "0 4 * * *"
    },
    {
      "path": "/api/integrations/cron/daily-content",
      "schedule": "0 5 * * *"
    }
  ]
}
